# syntax=docker/dockerfile:1.7
#
# Development image: keeps full Rust toolchain, adds cargo-watch for
# hot-reload on source changes, and relies on a bind mount (see
# docker-compose.dev.yml) rather than baking source into the image.
FROM rust:1.82-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN cargo install cargo-watch --locked && \
    cargo install sqlx-cli --locked --no-default-features --features rustls,postgres

WORKDIR /app

# Pre-warm the dependency cache using just the manifests, so a fresh
# `docker compose up` doesn't recompile every dep on first run.
COPY Cargo.toml Cargo.lock ./
RUN mkdir -p src && echo "fn main() {}" > src/main.rs && \
    cargo build && \
    rm -rf src

# Actual source is bind-mounted in docker-compose.dev.yml, so nothing
# else is copied here. cargo-watch rebuilds and restarts on save.
EXPOSE 3000

CMD ["cargo", "watch", "-x", "run"]
